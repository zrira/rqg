{
  "name": "@rqg/nestjs",
  "version": "0.1.0",
  "description": "NestJS 11 integration for rqg",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zrira/rqg.git",
    "directory": "packages/nestjs"
  },
  "homepage": "https://github.com/zrira/rqg#readme",
  "bugs": "https://github.com/zrira/rqg/issues",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@rqg/core": "0.1.0"
  },
  "peerDependencies": {
    "@nestjs/common": ">=11.0.0 <12",
    "@nestjs/core": ">=11.0.0 <12",
    "reflect-metadata": ">=0.2.0 <1",
    "rxjs": ">=7.8.0 <8"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
